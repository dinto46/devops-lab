services:
  db:
    image: postgres:18
    restart: unless-stopped
    environment:
      POSTGRES_DB: taskmanager
      POSTGRES_USER: taskmanager_user
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in app/.env}
    volumes:
      - postgres_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U taskmanager_user -d taskmanager"]
      interval: 5s
      timeout: 5s
      retries: 10


  api:
    build:
      context: .
      dockerfile: Dockerfile
    restart: unless-stopped
    env_file:
     - app/.env
    environment:
      DATABASE_URL: postgresql+psycopg2://taskmanager_user:${POSTGRES_PASSWORD}@db:5432/taskmanager
    ports:
     - "8000:8000"
    depends_on:
      db:
        condition: service_healthy


volumes:
  postgres_data:
